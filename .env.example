# ==================== 功能开关总览 (ON / OFF) ====================
# 全部布尔开关集中速览；详细参数见下方各段。
# [LLM] 标记的功能共用同一个「LLM 客户端」(见 LLM 段)，任一开启即初始化该客户端；
# 默认已开启 LLM 重排 + 意图分类：请配置好 LLM 段密钥，或把 [LLM] 开关改回 false。
#
#   EMBED_ENABLED=true                               嵌入（关→只切块不写向量库）
#   WORKER_ENABLED=true                              后台嵌入 worker（关→需手动 embed_pending）
#   RETRIEVAL_PATH_INDEX_ENABLED=true                路径索引（文件名/路径召回增强）
#   RERANK_ENABLED=false                              API 重排（Qwen3-Reranker）
#   LLM_RERANK_ENABLED=true                   [LLM] LLM 语义重排
#   RETRIEVAL_QUERY_REWRITE_ENABLED=false      [LLM] 查询改写（仅特殊场景增益，默认关）
#   RETRIEVAL_INTENT_CLASSIFICATION_ENABLED=true [LLM] 意图分类驱动检索策略
#   RETRIEVAL_QUERY_DECOMPOSITION_ENABLED=true       多句查询拆分并行召回
#   MONITORING_ENABLED=true                         监控采集与落库（调用/token/资源）
#   LOG_FILE_ENABLED=false                          日志落盘（关→仅控制台输出）
#
# 检索链路：dense + exact + path 召回 → RRF 融合 → source priority
#           → 重排 → 置信度过滤 → 覆盖度选择

# ==================== API Configuration ====================
# HTTP Bearer token accepted by the retrieval API.
# API 访问令牌（用于 Authorization: Bearer <token> 鉴权）
# 服务模式为共享部署，必须改为强随机值；请勿沿用个人模式的公开约定值 sk-opencontextengine。
API_KEY=replace-with-a-long-random-value
# Admin 接口密钥；留空则回落到 API_KEY，一旦配置则 admin 接口只认此 key
# ADMIN_API_KEY=

# --- CORS 跨域（供公共 GitHub Pages 上的 admin 前端调用）---
# Browser origins allowed to call the API (comma-separated).
# 允许访问 API 的浏览器来源，多个用逗号分隔。
# 默认已放行官方 admin 面板 https://oce-ai.github.io，用公共面板无需配置即可跨域调用。
# 部署在自定义域名/私有地址时用本项覆盖；设为空（CORS_ORIGINS=）则关闭 CORS。
# CORS_ORIGINS=https://oce-ai.github.io

# ==================== Database Configuration ====================
# PostgreSQL metadata store.
# PostgreSQL 连接字符串（格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名）
DB_URL=postgresql+asyncpg://oce:your_password_here@localhost:5432/oce
# 连接池大小（并发连接数）
# DB_POOL_SIZE=5
# 连接池最大溢出数（超过 POOL_SIZE 时的额外连接数）
# DB_MAX_OVERFLOW=5

# ==================== Milvus Configuration ====================
# Milvus dense vector store.
# Milvus 端点：HTTP 服务地址，或本地 Milvus Lite 文件路径（个人模式）
# MILVUS_ENDPOINT=http://localhost:19530
# Milvus collection 名称（自动创建，包含 dense 字段）
# MILVUS_COLLECTION_NAME=oce_chunks
# 路径索引 collection 名称（自动创建，存储路径向量）
# MILVUS_PATH_COLLECTION_NAME=oce_paths_v1
# Dense 向量维度（必须与 EMBED_DIMENSIONS 一致）
# MILVUS_DENSE_DIM=1024
# HNSW 索引参数（影响召回质量与建库耗时）
MILVUS_HNSW_M=32
MILVUS_HNSW_EF_CONSTRUCTION=512
MILVUS_HNSW_EF_SEARCH=512

# ==================== Embedding Configuration ====================
# 向量嵌入服务配置（OpenAI 兼容接口；Gitee AI / SiliconFlow / llama.cpp server 均可）

# Fallback when model_credentials has no active kind=embed row.
# 是否启用向量嵌入（false 时只切块不嵌入，用于测试）
# EMBED_ENABLED=true
# 嵌入服务 API 端点（OpenAI 兼容接口）
# EMBED_ENDPOINT=https://ai.gitee.com/v1/embeddings
# 嵌入服务 API 密钥（从 model_credentials 表 kind=embed 动态加载，此为 fallback）
EMBED_API_KEY=your_embedding_api_key_here
# 嵌入模型名称（Qwen3-Embedding 系列实测：8B 质量最优，4B 性价比，0.6B 低延迟）
# EMBED_MODEL=Qwen3-Embedding-8B
# Query 侧指令（拼在 query 前，空则不加）。
# 模型名含 qwen3-embedding/qwen3_embed/f2llm 时自动启用 code retrieval 指令 +
# Instruct 模板，无需手动设置；jina 系列需手动设 EMBED_QUERY_INSTRUCTION="Query: "
# EMBED_QUERY_INSTRUCTION=
# 指令模板：none = 裸拼接 {instruction}{text}；instruct_query = "Instruct: {instruction}\nQuery: {text}"
# （Qwen3-Embedding / F2LLM-v2 官方格式）
# EMBED_INSTRUCTION_TEMPLATE=instruct_query
# 向量维度（必须与模型输出维度匹配）
# EMBED_DIMENSIONS=1024
# 单批次最多嵌入的文本条数（Gitee AI 上限 24）
# EMBED_MAX_BATCH_SIZE=24
# 单批次输入的最大字符数（SiliconFlow 限制 32K 字符）
# EMBED_MAX_BATCH_CHARS=32000
# 单条输入的最大字符数（超过会自动分段嵌入后池化）
# EMBED_MAX_INPUT_CHARS=8000
# 分段嵌入时的重叠字符数（保证语义连续性）
# EMBED_INPUT_OVERLAP_CHARS=400
# 并发请求数上限（控制 API 调用速率）
# EMBED_MAX_CONCURRENCY=4
# llama.cpp 后端专用：true 时拆批量为并发单条请求，利用服务端 -np 多 slot 并行
# （llama.cpp 批量请求在单 slot 内串行；真 OpenAI 兼容 API 保持 false）
# EMBED_SINGLE_REQUEST=false

# ==================== LLM 客户端（重排 / 改写 / 意图）====================
# ★ 三个功能各自按 kind 从 model_credentials 表解析凭证（kind=llm_rerank /
#   query_rewrite / intent），可分别配置 key/base_url/model/tpm；本段为统一 fallback：
#     LLM_RERANK_ENABLED（本段）
#     RETRIEVAL_QUERY_REWRITE_ENABLED（Retrieval 段）
#     RETRIEVAL_INTENT_CLASSIFICATION_ENABLED（Retrieval 段）
#   表中无对应 kind 的 active 行时回落本段。默认已开启 LLM 重排 + 意图分类。

# --- 客户端连接 ---
LLM_API_KEY=your_llm_api_key_here
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_PROXY=
# 默认模型（LLM 重排 + 意图分类用；查询改写另用 RETRIEVAL_QUERY_REWRITE_MODEL）
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 接口 TPM 上限（>0 时客户端排队限流，防止连续 429）
# LLM_TPM_LIMIT=60000
# Qwen3 等混合思考模型兼容：auto（默认）对已知提供方（SiliconFlow/DashScope/
# vLLM/Ollama 等）自动注入 enable_thinking=false，避免思考链烧尽 max_tokens
# 后返回空 content；true/false 可显式强制开/关（严格校验未知参数的提供方设 false）
# LLM_ENABLE_THINKING=auto

# --- LLM 语义重排（默认主重排层）---
# [开关] 与下方 API 重排二选一或叠加
# LLM_RERANK_ENABLED=true
# LLM_MAX_CANDIDATES=50
# LLM_OUTPUT_TOP_K=10
# 每候选送入 LLM 的代码字符上限
# LLM_SNIPPET_CHARS=1600

# ==================== API 重排（Reranker）====================
# [开关] 端点重排；密钥空则复用 EMBED_API_KEY，也可从 model_credentials 表 kind=rerank 动态加载。
# reranker 实测（flask，Qwen3-Embedding-8B + top_k=24）：zerank-2 +9.0 >
# Qwen3-Reranker-8B +4.9 > rerank-v4.0-pro/rerank-2.5 +1.4；弱 reranker
# （0.6B 级 / jina-v3.5）负收益——嵌入已准时不要用弱重排。
# RERANK_ENABLED=false
# RERANK_ENDPOINT=https://router.tumuer.me/v1/rerank
RERANK_API_KEY=your_rerank_api_key_here
# RERANK_MODEL=zerank-2
# 返回条数（通常与检索 top_k 一致）
# RERANK_TOP_N=10
# 单次请求文档数上限：超过则分批串行，全局重排后截断（Gitee 上限 24）
# RERANK_MAX_DOCS=24

# ==================== Retrieval Configuration ====================
# 检索管线配置：query → 多查询并行召回 → 结果融合 → Rerank → 覆盖度选择

# --- 基础召回参数 ---
# 单查询模式下的向量召回条数（关闭查询分解时使用）
# 单查询模式下的向量召回条数；与 RERANK_MAX_DOCS 对齐时 rerank 收益最大
# （实测 flask：tk24+rerank 比 tk120+rerank 高 2.8 分；无 rerank 时 24/120 无差）
# RETRIEVAL_DEFAULT_TOP_K=24
# 最终返回的片段数量上限（软限制，实际受字符预算和文件数约束）
# RETRIEVAL_FINAL_SELECT_K=10
# Milvus 向量分数过滤阈值 [0.0-1.0]，0.0 表示不预过滤
# RETRIEVAL_VECTOR_THRESHOLD=0.0
# 最终置信度门槛 [0.0-1.0]，低于此分数的结果会被过滤
# RETRIEVAL_CONFIDENCE_FLOOR=0.0

# --- 多查询结果融合 ---
# 多查询结果的 RRF 融合平滑常数
# RETRIEVAL_RRF_K=60

# --- 多查询分解与并行召回 ---
# 是否将复杂查询拆分成多个子查询（保留完整查询 + 句子级子查询）
# RETRIEVAL_QUERY_DECOMPOSITION_ENABLED=true
# 查询总数上限（1 个主查询 + N-1 个子查询），1-8 之间
# RETRIEVAL_QUERY_MAX_QUERIES=4
# 子查询最少字符数，低于此长度的句子片段会被忽略
# RETRIEVAL_QUERY_MIN_FACET_CHARS=8
# 子查询在结果融合中的权重（主查询权重固定为 1.0）
# RETRIEVAL_QUERY_FACET_WEIGHT=0.75
# 多查询模式下每个查询的召回条数（避免候选池过大）
# 例：4 查询 × 20 条 = 80 条候选，vs 单查询 50 条
# RETRIEVAL_PER_QUERY_TOP_K=20

# --- 上下文剪枝与覆盖度 ---
# 单个文件最多返回的片段数（保证仓库覆盖度）
# RETRIEVAL_MAX_CHUNKS_PER_PATH=2
# 返回代码的总字符预算（硬限制，LLM 上下文窗口约束）
# 贪心填充策略：跳过放不下的大片段，继续尝试小片段
# RETRIEVAL_MAX_CONTEXT_CHARS=32000
# 同文件内片段重叠抑制阈值 [0.0-1.0]
# 重叠行数 / 较短片段行数 >= 此值时去重
# RETRIEVAL_OVERLAP_THRESHOLD=0.6

# --- 路径索引 ---
# [开关] 独立路径向量索引，与内容结果融合
# RETRIEVAL_PATH_INDEX_ENABLED=true

# --- 查询改写 [LLM]（依赖上方 LLM 客户端）---
# [开关] 仅跨语言文件名等特殊场景有增益，默认关；开启需先配置好 LLM 客户端
# RETRIEVAL_QUERY_REWRITE_ENABLED=false
# 改写模型（可与 LLM_MODEL 不同）
# RETRIEVAL_QUERY_REWRITE_MODEL=Qwen/Qwen2.5-7B-Instruct
# RETRIEVAL_QUERY_REWRITE_NUM=3

# --- 意图分类 [LLM]（依赖上方 LLM 客户端）---
# [开关] 开启后每 query 调 LLM 分类意图(~150ms)再选策略（默认开）
# RETRIEVAL_INTENT_CLASSIFICATION_ENABLED=true

# --- 文件描述注入 [实验] ---
# [开关] 规则层文件描述（清单/配置/入口文件名→英文桥接句，README 首段）
# 注入 embedding_text 与 rerank 文档，弥合「中文查询 vs TOML/CSS 内容零词法重叠」。
# 默认关（A/B 实验开关）；开启后模型指纹变为 etext=v2，旧索引启动时
# fail-closed 提示重建（静态嵌入零成本；API 嵌入需重嵌，flask 230 blob/
# cc-switch 1031 blob 量级实测秒级到几十秒）。
# RETRIEVAL_FILE_DESC_ENABLED=false

# --- related symbols hints [实验] ---
# [开关] 输出层追加 <related_symbols> 块：选中内容引用但定义未入窗的
# 符号（含定义路径），agent 可据此跟进检索（grep leads）。不动排序、
# 不改结果集，评测评分不受影响。默认关。
# RETRIEVAL_RELATED_SYMBOLS_ENABLED=false

# --- rerank 悬崖截断 [实验] ---
# [开关] 仅作用于 API 重排（RERANK_ENABLED，已被 LLM 重排取代、默认关）
# 的端点校准分：head×0.35 与绝对下限 0.10 双线以下的弱尾部丢弃，最少
# 保留 6 条。LLM 重排只返回顺序无校准分，不受此开关影响（其截断语义
# 由 prompt 的 "output fewer — do not pad" 天然承担）。默认关。
# RETRIEVAL_RERANK_CUTOFF_ENABLED=false

# --- broad mode（架构/概览探索查询专用 regime）[实验] ---
# [开关] 触发 = LLM 意图判为 Overview ∨ 启发式架构词表（架构/技术栈/
# 部署/framework/architecture…中英双语；裸「配置」刻意缺席）。regime 差异：
# 宽窗口 20 hits、单文件最多 2 片（覆盖优先于深度）、清单文件结构先验
# （package.json/pyproject.toml/Dockerfile… 作为一路额外融合）、超 28 行
# 摘录骨架化（头 12 行 + 查询词命中行，省略段标注真实行号区间）。
# 默认关。
# RETRIEVAL_BROAD_MODE_ENABLED=false

# --- 元目录降权 [实验] ---
# [开关] .github/.gitlab/.circleci 等 CI/模板基础设施目录 ×0.5 降权（对普通
# 代码问题是纯噪声）；查询明确点名 CI/工作流（github/action/工作流/流水线…）
# 时豁免。仅主检索路生效，路径增强定位查询不受影响。默认关。
# RETRIEVAL_META_DIR_PENALTY_ENABLED=false

# --- 相邻 span 合并 + 小片段补全 [实验] ---
# [开关] 同文件相距 ≤2 行的选中片段合并成一个连续段，<6 行的片段两侧各补
# 3 行上下文；内容从 chunk 行重构，覆盖有洞时回退原样（行号永不撒谎）。
# select 池加宽 8 条，合并缩窗后由次优排名回填。默认关。
# RETRIEVAL_SPAN_MERGE_ENABLED=false

# ==================== Redis Queue Configuration ====================
# Redis task queue (for async upload/embedding).
# Redis 连接字符串（格式：redis://:密码@主机:端口/库号）
REDIS_URL=redis://:your_redis_password_here@localhost:6379/0
# 队列键名前缀。实际会用到三个键：
#   {name}            主队列（待处理）
#   {name}:processing  处理中（worker 取走暂存，崩溃后可恢复）
#   {name}:pending     在飞哨兵集合（入队去重，防幽灵消息堆积）
# REDIS_QUEUE_NAME=oce:embed_queue

# ==================== Worker Configuration ====================
# Background worker (consumes embed queue).
# 是否启用后台 worker（false 时队列不消费，需手动触发 embed_pending）
# WORKER_ENABLED=true
# 并发消费协程数（每个协程独立 UoW，互不共享可变状态）
# WORKER_CONCURRENCY=2
# 单个 blob 的最大重试次数（超限置 error 并清理 staging 原文）
# WORKER_MAX_RETRIES=3

# ==================== Logging Configuration ====================
# 日志落盘与格式（默认仅输出到控制台）。
# [开关] 是否启用日志落盘（false 时仅控制台输出）
# LOG_FILE_ENABLED=false
# 日志文件路径（留空 / None 时按运行模式自动推断）
# LOG_FILE_PATH=
# 轮转策略：'1 day' 按天 / '100 MB' 按大小
# LOG_ROTATION=100 MB
# 保留时长：'30 days' 按时间 / '10 files' 按文件数
# LOG_RETENTION=30 days
# 是否使用 JSON 格式（便于日志采集）
# LOG_FORMAT_JSON=false
# 日志级别（WARNING / INFO / DEBUG）
# LOG_LEVEL=INFO

# ==================== Monitoring Configuration ====================
# 调用 / token / 资源指标采集与落库，含检索阶段审计。
# [开关] 是否启用监控采集与落库（关→不写 metrics 表）
# MONITORING_ENABLED=true
# 缓冲区批量写库间隔秒数
# MONITORING_FLUSH_INTERVAL_SECONDS=5.0
# 单类指标缓冲上限，超出立即 flush
# MONITORING_FLUSH_MAX_BUFFER=500
# 资源采样间隔秒数（CPU / 内存等）
# MONITORING_RESOURCE_SAMPLE_INTERVAL_SECONDS=60.0
# 监控数据保留天数（GC 清理阈值）
# MONITORING_RETENTION_DAYS=30
# 监控数据清理任务运行间隔秒数
# MONITORING_CLEANUP_INTERVAL_SECONDS=3600.0
# 是否记录检索各阶段耗时与空回审计
# MONITORING_RETRIEVAL_AUDIT_ENABLED=true
# 检索审计是否存储 query 原文（默认关，隐私安全）
# MONITORING_STORE_QUERY_TEXT=false

# ==================== 高级/可选（有代码默认值，通常无需设置）====================
# 需要时取消注释以覆盖默认值。
# MILVUS_TOKEN=                          # Zilliz Cloud 认证 token
# MILVUS_DENSE_INDEX_TYPE=HNSW
# MILVUS_DENSE_METRIC_TYPE=COSINE
# EMBED_TIMEOUT_SECONDS=60
# EMBED_PROXY=
# RERANK_MIN_SCORE=0.05                  # API 重排最低分
# RERANK_TIMEOUT_SECONDS=60
# RETRIEVAL_EXACT_MAX_SCOPE_BLOBS=2000   # 精确标识符召回最大 blob scope；0=禁用
# RETRIEVAL_EXACT_TIMEOUT_SECONDS=2.0
# RETRIEVAL_PATH_BOOST_WEIGHT=0.5        # 路径命中对同文件 chunk 的加权系数
# DB_ECHO=false                          # 打印 SQL 日志
# RETRIEVAL_RERANK_POOL_K=0              # rerank 候选池截断（0=不截断；实测与
#                                          #   向量 top_k 解耦无额外收益，保持 0）
# OCE_MEMORY_LIMIT_MB=0                   # 进程内存硬限 MB（0=不限；macOS 用
#                                          #   phys_footprint 口径，超限拒新嵌入）

# ==================== Rust 版专属（TriviumDB / 本地嵌入）====================
# 仅 Rust OCE（个人模式）读取；Python 版忽略。
# TRIVIUM_TEXT_HYBRID=true                # BM25+dense RRF 混合（标识符门控后 +4.4 分）
# TRIVIUM_TEXT_BOOST=0.3                 # BM25 融合权重（0.3 实测最优；1.5 会 -20 分）
# TRIVIUM_EXPAND_DEPTH=0                 # 图扩散深度（1 会 -33 分，保持 0）
# EMBED_PROVIDER=auto                     # auto|openai|static|local（local=candle CPU）
# EMBED_STATIC_MODEL=minishlab/potion-base-8M   # static provider 的模型
# EMBED_LOCAL_MODEL=Qwen/Qwen3-Embedding-0.6B   # local provider 的 candle 模型
# EMBED_LOCAL_DTYPE=f32                  # local 精度 f32|f16|bf16
